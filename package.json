{
  "name": "axk-stellar",
  "version": "0.1.0",
  "description": "Settlement and cash-out rails for verified commodity trade on Stellar",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/axknetwork/axk-stellar.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "anchors": "npm run dev -w @axk/anchors --",
    "serve": "npm run serve -w @axk/anchors"
  }
}
