# AXK anchor client (custodial MoneyGram SEP-10 + SEP-24).
# Copy to .env and fill in. Never commit the filled file.

# sandbox | production
MGI_ENV=sandbox

# Optional override; default is MoneyGram home domain for MGI_ENV
# MGI_HOME_DOMAIN=extmgxanchor.moneygram.com

# Client domain declared with the anchor, no scheme.
# Not required for custodial integrations; harmless if the anchor has one on file.
MGI_CLIENT_DOMAIN=api.example.org

# Custodial Stellar secrets (S...) — NEVER commit real values
# Auth wallet: the SEP-10 authentication account registered with the anchor.
MGI_AUTH_SECRET=

# Funds wallet: sends USDC on cash-out / receives USDC on cash-in
# Can be the same as auth for early sandbox; production often splits deposit/withdraw
MGI_FUNDS_SECRET=

# Optional separate deposit/withdraw publics for docs / portal display (G...)
# MGI_DEPOSIT_PUBLIC=
# MGI_WITHDRAW_PUBLIC=

# USDC issuer on Stellar (Circle). Testnet vs mainnet differ — override if needed.
# Leave blank to resolve from MoneyGram SEP-24 / TOML currencies.
# MGI_USDC_ISSUER=

# HTTP API
# Required. The /v1 routes can start ramps and move USDC, so the server refuses
# to start without this. Generate one with: openssl rand -hex 32
MGI_API_KEY=

PORT=5055
# Comma-separated origins for CORS (desk / POC)
CORS_ORIGINS=http://localhost:3000,http://localhost:5055

# Optional: bind API to loopback only in prod behind reverse proxy
# HOST=127.0.0.1

# Email shown in the `keys` command output for anchor onboarding forms.
# MGI_PORTAL_EMAIL=ops@example.org
